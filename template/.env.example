# AWS CDK環境設定
# AWSアカウントID（12桁の数字）
CDK_DEFAULT_ACCOUNT=123456789012

# デフォルトリージョン
CDK_DEFAULT_REGION=ap-northeast-1

# ドメイン設定
# あなたが所有するドメイン名
# ワイルドカード証明書（*.example.com）の場合、証明書のみ作成されます
DOMAIN_NAME=example.com

# CloudFront設定
# CloudFrontを使用するか（true/false）
# ワイルドカード証明書の場合は自動的にfalseになります
USE_CLOUDFRONT=true

# オリジンタイプ（s3-new, s3-website-new, s3-website-existing, s3-existing, http, alb, apigateway）
# ワイルドカード証明書の場合は使用されません
# s3-new: 新規S3バケット（OAC経由・推奨）
# s3-website-new: 新規S3バケット（静的ウェブサイトホスティング）
# s3-website-existing: 既存のS3静的ウェブサイト
# s3-existing: 既存のS3バケット（OAC経由）
ORIGIN_TYPE=s3-new

# オリジンドメイン（http, alb, apigateway, s3-existing, s3-website-existingの場合に必要）
# 例: origin.example.com, bucket-name.s3-website-ap-northeast-1.amazonaws.com
# ORIGIN_DOMAIN=origin.example.com

# オリジンパス（オプション）
# ORIGIN_PATH=/api

# 監視設定
# 証明書の有効期限監視を有効にするか（true/false）
USE_MONITORING=true

# 通知先メールアドレス（監視を有効にした場合必須）
NOTIFICATION_EMAIL=admin@example.com

# 環境設定（dev, stg, prod）
ENVIRONMENT=dev

# 既存の証明書ARN（オプション）
# 既存の証明書を使用する場合は指定
# CERTIFICATE_ARN=arn:aws:acm:region:account-id:certificate/certificate-id