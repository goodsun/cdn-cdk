{
  "name": "@goodsun/create-cdn",
  "version": "0.0.19",
  "description": "CLI tool to easily create AWS CDN with CloudFront and ACM certificates",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "author": "goodsun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodsun/create-cdn.git"
  },
  "keywords": [
    "aws",
    "cdk",
    "cdn",
    "cloudfront",
    "acm",
    "certificate"
  ],
  "bugs": {
    "url": "https://github.com/goodsun/create-cdn/issues"
  },
  "homepage": "https://github.com/goodsun/create-cdn#readme",
  "bin": {
    "create-cdn": "./bin/create-cdn.js",
    "create-cert": "./bin/create-cert.js",
    "create-route53": "./bin/create-route53.js"
  },
  "files": [
    "lib",
    "bin",
    "template",
    "template/.env.example",
    "scripts",
    "docs/route53-setup.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "npm run build && cdk deploy",
    "deploy:all": "npm run build && cdk deploy --all",
    "destroy": "cdk destroy --all",
    "synth": "npm run build && cdk synth",
    "validate": "npm run build && node scripts/validate-certificates.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/aws-sdk": "^0.0.42",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "aws-cdk": "^2.130.0",
    "aws-sdk": "^2.1692.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.130.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "constructs": "^10.3.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.3.0",
    "inquirer": "^8.2.6",
    "source-map-support": "^0.5.21"
  }
}
